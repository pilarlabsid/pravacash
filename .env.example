# ==============================================
# PRAVA CASH - Environment Variables Template
# Salin file ini menjadi .env dan isi nilainya
# ==============================================

# ─── Database ────────────────────────────────
# Untuk Neon: salin connection string dari dashboard Neon
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pravacash?schema=public"

# ─── JWT (Authentication) ────────────────────
# Ganti dengan string acak yang panjang dan aman di production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Cloudinary (Upload Bukti Transaksi) ─────
# Daftar gratis di: https://cloudinary.com
# Ambil dari: Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
